{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pinheirofilipem-ux/pine3-wall/schema/layout.schema.json",
  "title": "Pine3 Wall layout",
  "description": "What each screen shows, in which order and size. Sent as 'layout' in the home model. Section and card types come from schema/catalog.json; renderers must tolerate types they don't know.",
  "type": "object",
  "required": ["schema_version", "generated", "options", "dock", "pages"],
  "properties": {
    "schema_version": {"const": 1},
    "generated": {"type": "boolean", "description": "true: built automatically from the settings; false: edited in the web editor."},
    "options": {
      "type": "object",
      "required": ["display", "clock_24h", "animations"],
      "properties": {
        "display": {"enum": ["grid", "list"]},
        "clock_24h": {"type": "boolean"},
        "animations": {"type": "boolean"}
      }
    },
    "dock": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Page keys shown in the dock, in order."},
    "pages": {
      "type": "object",
      "description": "Page key -> page. Fixed keys (home, rooms, house, scenes, climate, security) and one 'room/<room id>' per room.",
      "required": ["home"],
      "additionalProperties": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "template": {"type": "string", "description": "How the sections are arranged (module catalog 'templates')."},
        "room": {"type": "string"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
      }
    },
    "section": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "items": {"type": "array", "items": {"type": "string"}},
        "room": {"type": "string"},
        "group": {"enum": ["category"]},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}}
      }
    },
    "card": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "size": {"enum": ["normal", "big"]},
        "room": {"type": "string"},
        "entity": {"type": "string"},
        "summary": {"type": "string"}
      }
    }
  }
}
